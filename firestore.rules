rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'eKhkvvFajRX6XfOP3baFBh5n5V33';
    }

    // Homepage event info + social links — public read, admin-only write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shop products — public read, admin-only write
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Photos/videos — public read, admin-only write
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — written only by the trusted Cloud Function (admin SDK bypasses rules),
    // readable only by the admin.
    match /orders/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Community photo submissions — anyone can submit (goes in as 'pending'), but only
    // approved ones are publicly readable; admin sees/moderates everything.
    match /communityPhotos/{docId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Facebook-style reactions — no login, just a per-browser anonymous device ID.
    // Publicly readable (needed to show counts) and publicly writable (this is a
    // low-stakes fun feature, not something that needs real auth to protect).
    match /reactions/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.emoji in ['like', 'love', 'haha', 'wow', 'sad', 'angry']
        && request.resource.data.targetId is string
        && request.resource.data.deviceId is string;
      allow delete: if true;
    }

    // Contact form — anyone can send a message, only admin can read/manage them.
    match /contactMessages/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.read == false
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string;
    }
  }
}
