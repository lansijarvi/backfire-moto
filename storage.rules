rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'eKhkvvFajRX6XfOP3baFBh5n5V33';
    }

    match /backfire/gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 200 * 1024 * 1024;
    }
    match /backfire/hero/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 20 * 1024 * 1024;
    }
    match /backfire/events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 20 * 1024 * 1024;
    }
    match /backfire/products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 20 * 1024 * 1024;
    }
    // Community photo/video submissions — anyone can upload (moderation happens in
    // Firestore, not here), capped at 50MB, images or short videos only.
    match /backfire/community/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'));
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
