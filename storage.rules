rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Flyer, product, and gallery images/videos — public read, admin-only upload
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'eKhkvvFajRX6XfOP3baFBh5n5V33';
    }
  }
}
